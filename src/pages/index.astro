---
import BaseLayout from '../layouts/BaseLayout.astro'
const base = import.meta.env.BASE_URL
---

<BaseLayout title="Home">

  <!-- Hero -->
  <section class="flex flex-col items-center justify-center text-center px-6 py-32">
    <span class="text-xs font-semibold uppercase tracking-widest text-subtle mb-4">Judging. Simplified.</span>
    <h1 class="text-6xl font-bold tracking-tight mb-6 max-w-3xl">
      Get your results <span class="text-text">in a </span><span class="text-brand">Snap</span>
    </h1>
    <p class="text-muted text-lg max-w-xl mb-10">
      SnapForm lets you build custom judging forms, manage participants, and see live scores — all in one place.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 items-center mb-16">
      <a href="#mailing-list" class="bg-brand text-dark font-semibold px-6 py-3 rounded-full hover:bg-brand-hover transition-colors">
        Get Started Free
      </a>
      <a href="#features" class="text-muted hover:text-text transition-colors text-sm">
        See how it works →
      </a>
    </div>

    <!-- Mailing List -->
    <div id="mailing-list" class="bg-surface border border-border rounded-2xl p-8 max-w-md w-full scroll-mt-40">
      <h2 class="text-lg font-semibold mb-2">Stay in the loop</h2>
      <p class="text-muted text-sm mb-4">Get notified when we launch new features.</p>
      <form class="flex gap-2">
        <input
          type="email"
          placeholder="your@email.com"
          class="flex-1 bg-border border border-border text-text text-sm px-4 py-2 rounded-full outline-none focus:border-brand transition-colors"
        />
        <button
          type="submit"
          class="bg-brand text-dark font-semibold text-sm px-4 py-2 rounded-full hover:bg-brand-hover transition-colors"
        >
          Subscribe
        </button>
      </form>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="px-6 py-24 max-w-5xl mx-auto">
    <h2 class="text-3xl font-bold text-center mb-16">Everything you need to run your event</h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

      <div class="bg-surface border border-border rounded-2xl p-6">
        <div class="text-brand text-3xl mb-4">⚡</div>
        <h3 class="text-lg font-semibold mb-2">Build Forms Fast</h3>
        <p class="text-muted text-sm">Drag and drop form components onto a canvas. No code required.</p>
      </div>

      <div class="bg-surface border border-border rounded-2xl p-6">
        <div class="text-brand text-3xl mb-4">👥</div>
        <h3 class="text-lg font-semibold mb-2">Manage Judges & Participants</h3>
        <p class="text-muted text-sm">Add judges and participants in seconds. Share a judging link and they're ready to go.</p>
      </div>

      <div class="bg-surface border border-border rounded-2xl p-6">
        <div class="text-brand text-3xl mb-4">📊</div>
        <h3 class="text-lg font-semibold mb-2">Live Scoreboard</h3>
        <p class="text-muted text-sm">Scores update in real time. Download a full CSV report when your event ends.</p>
      </div>

    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-border px-8 py-8 flex items-center justify-between text-subtle text-sm">
    <span>© 2026 SnapForm. All rights reserved.</span>
    <div class="flex gap-6">
      <a href={`${base}about`} class="hover:text-text transition-colors">About</a>
      <a href={`${base}contact`} class="hover:text-text transition-colors">Contact</a>
      <a href={`${base}pricing`} class="hover:text-text transition-colors">Pricing</a>
    </div>
  </footer>

</BaseLayout>
