---
const base = import.meta.env.BASE_URL
---

<nav class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-8 py-4 bg-bg border-b border-border">
  <a href={base} class="flex items-center gap-2">
    <img src={`${base}Snapform Logo.png`} alt="SnapForm Logo" class="h-24 w-auto" />
    <span class="text-text font-bold text-xl tracking-tight">SnapForm</span>
  </a>

  <div class="flex items-center gap-8">
    <a href={base} class="text-muted hover:text-text transition-colors text-sm">Home</a>
    <a href={`${base}about`} class="text-muted hover:text-text transition-colors text-sm">About</a>
    <a href={`${base}pricing`} class="text-muted hover:text-text transition-colors text-sm">Pricing</a>
    <a href={`${base}contact`} class="text-muted hover:text-text transition-colors text-sm">Contact</a>
    <a href="#mailing-list" class="bg-text text-dark text-sm font-semibold px-4 py-2 rounded-full hover:bg-brand-hover transition-colors">Get Started</a>
  </div>
</nav>
